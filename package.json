{
  "name": "durable-zero",
  "version": "0.5.0",
  "description": "Sovereign, ACID-persisted agent runtime, task graph, QuickJS codemode sandbox, and CLI",
  "type": "module",
  "license": "MIT",
  "author": "Ivan Arc",
  "exports": {
    ".": {
      "import": "./packages/core/dist/index.js",
      "types": "./packages/core/src/index.ts"
    },
    "./core": {
      "import": "./packages/core/dist/index.js",
      "types": "./packages/core/src/index.ts"
    },
    "./contracts": {
      "import": "./packages/contracts/dist/index.js",
      "types": "./packages/contracts/src/index.ts"
    },
    "./sdk": {
      "import": "./packages/sdk/dist/index.js",
      "types": "./packages/sdk/src/index.ts"
    },
    "./plugins": {
      "import": "./packages/plugins/dist/index.js",
      "types": "./packages/plugins/src/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./packages/core/src/index.ts"
      ],
      "contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "plugins": [
        "./packages/plugins/src/index.ts"
      ]
    }
  },
  "scripts": {
    "prepare": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.ts",
    "lint": "pnpm -r run lint"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@sinclair/typebox": "^0.34.14",
    "proper-lockfile": "^4.1.2",
    "quickjs-wasi": "3.6.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
